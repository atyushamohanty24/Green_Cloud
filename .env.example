# ==============================================================================
# GREENCLOUD AI - SAMPLE ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and backend/.env and replace placeholders with your credentials.
# ==============================================================================

PROJECT_NAME=GreenCloud AI Engine
ENVIRONMENT=development
DATABASE_URL=sqlite:///./greencloud.db

# 1. AWS IAM Credentials & Identity
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=ap-south-1
AWS_ACCOUNT_ID=YOUR_AWS_ACCOUNT_ID
AWS_IAM_USER=GreenCloud_Admin
AWS_IAM_ROLE_ARN=arn:aws:iam::YOUR_AWS_ACCOUNT_ID:role/GreenCloudAutomationExecutorRole
AWS_IAM_POLICY_ARN=arn:aws:iam::YOUR_AWS_ACCOUNT_ID:policy/GreenCloudLeastPrivilegeOptimizationPolicy

# 2. Networking & Governance
AWS_VPC_ID=vpc-xxxxxxxxxxxxxxxxx
AWS_VPC_CIDR=10.0.0.0/16
AWS_INTERNET_GATEWAY_ID=igw-xxxxxxxxxxxxxxxxx
AWS_ROUTE_TABLE_ID=rtb-xxxxxxxxxxxxxxxxx
AWS_SUBNET_1_ID=subnet-xxxxxxxxxxxxxxxxx
AWS_SUBNET_2_ID=subnet-xxxxxxxxxxxxxxxxx
AWS_BACKEND_SG_ID=sg-xxxxxxxxxxxxxxxxx
AWS_FRONTEND_SG_ID=sg-xxxxxxxxxxxxxxxxx
AWS_RDS_SG_ID=sg-xxxxxxxxxxxxxxxxx
AWS_RDS_DB_SUBNET_GROUP=greencloud-db-subnet-group

# 3. Storage & Archival
AWS_S3_LOGS_BUCKET=prod-raw-access-logs-YOUR_ACCOUNT_ID
AWS_S3_TELEMETRY_BUCKET=greencloud-telemetry-data-YOUR_ACCOUNT_ID

# 4. Serverless & Monitoring
AWS_LAMBDA_FUNCTION_NAME=analytics-aggregator-fn
AWS_LAMBDA_FUNCTION_ARN=arn:aws:lambda:ap-south-1:YOUR_ACCOUNT_ID:function:analytics-aggregator-fn
AWS_CLOUDWATCH_LOG_GROUP=/aws/greencloud/telemetry
AWS_CLOUDWATCH_ALARM_NAME=greencloud-ec2-underutilized-cpu

# 5. Target EC2 Workload Instances
EC2_PROD_FRONTEND_ID=i-xxxxxxxxxxxxxxxxx
EC2_DEV_BACKEND_ID=i-xxxxxxxxxxxxxxxxx
EC2_STAGING_WORKER_ID=i-xxxxxxxxxxxxxxxxx
EC2_LEGACY_BATCH_ID=i-xxxxxxxxxxxxxxxxx

# 6. Scoring Weights
WEIGHT_UTILIZATION=0.30
WEIGHT_COST=0.35
WEIGHT_CARBON=0.25
WEIGHT_SAFETY=0.10
HIGH_RISK_COST_THRESHOLD_MONTHLY=200.0
HIGH_RISK_CAPACITY_REDUCTION_PCT=50.0

# 7. Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_AWS_REGION=ap-south-1
